# Copia este archivo a .env y rellena los valores (Supabase → Project Settings → API).
# Nunca subas .env al repo. Comparte las claves por gestor de contraseñas.

EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Id del servidor comunitario de Discord (para enlazar a los canales de match)
EXPO_PUBLIC_DISCORD_GUILD_ID=

# Clave de la API de KLIPY (GIFs del chat) — gratuita:
# partner.klipy.com → cuenta → API key (la de test da 100 llamadas/hora).
# (Tenor cerró su API el 30-06-2026; KLIPY es el relevo del mismo equipo.)
# Sin clave, la pestaña GIF simplemente no aparece.
EXPO_PUBLIC_KLIPY_API_KEY=

# Secrets de la Edge Function discord-match — van en Supabase
# (Edge Functions → Secrets), NUNCA en este archivo ni en el cliente:
#   DISCORD_BOT_TOKEN, DISCORD_GUILD_ID, WEBHOOK_SECRET, SB_SECRET_KEY
