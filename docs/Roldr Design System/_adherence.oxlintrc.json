{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/matchmaking/**",
              "components/navigation/**",
              "components/overlays/**",
              "components/profile/**",
              "ui_kits/roldr-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Outfit|Manrope|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Outfit, Manrope, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|ring|live|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, ring, live."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:live|neutral|success|warning|danger)$/]",
        "message": "<Badge> tone must be one of 'live' | 'neutral' | 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|key|ref|className|style|children)$/]",
        "message": "<BottomNavItem> doesn't accept that prop. Declared props: icon, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|fullWidth|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, fullWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:raised|padding|ambient|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: raised, padding, ambient."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|selected|tone|icon|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: label, selected, tone, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|live|success)$/]",
        "message": "<Chip> tone must be one of 'default' | 'live' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|icon|error|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, icon, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='MatchBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|gm|onOpen|onKeep|key|ref|className|style|children)$/]",
        "message": "<MatchBanner> doesn't accept that prop. Declared props: title, gm, onOpen, onKeep."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|onClose|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: open, title, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwipeActions'] > JSXAttribute > JSXIdentifier[name!=/^(?:onNo|onSuper|onYes|key|ref|className|style|children)$/]",
        "message": "<SwipeActions> doesn't accept that prop. Declared props: onNo, onSuper, onYes."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwipeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|system|gm|gmPhoto|imageUrl|tags|distance|seats|live|offset|decision|key|ref|className|style|children)$/]",
        "message": "<SwipeCard> doesn't accept that prop. Declared props: title, system, gm, gmPhoto, imageUrl, tags, distance, seats, live, offset, decision."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwipeCard'] > JSXAttribute[name.name='decision'] > Literal[value!=/^(?:yes|no)$/]",
        "message": "<SwipeCard> decision must be one of 'yes' | 'no'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|logoSrc|onBack|actionIcon|action|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: title, logoSrc, onBack, actionIcon, action."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
